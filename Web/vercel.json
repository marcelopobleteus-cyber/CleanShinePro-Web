{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/process", "destination": "/how-it-works", "permanent": true },
    { "source": "/booking", "destination": "/quote", "permanent": true },
    { "source": "/socios", "destination": "/es/socios", "permanent": true },
    { "source": "/become-a-partner", "destination": "/partners", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
